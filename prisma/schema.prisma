// Supabase is plain PostgreSQL, so no connection URL is needed here: the CLI
// reads it from `prisma.config.ts` and the app passes it to the pg driver
// adapter in `src/prisma/prisma.service.ts`.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"

  // Generated sources are git-ignored and rebuilt on install; run
  // `pnpm db:generate` after editing this file.
  output = "../src/generated/prisma"

  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}
